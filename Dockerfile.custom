# syntax=docker/dockerfile:1

FROM node:22.22.0-bookworm-slim AS frontend-build

WORKDIR /src

COPY package.json yarn.lock ./

RUN corepack enable \
    && corepack prepare yarn@1.22.22 --activate \
    && yarn install

COPY . .

RUN npm run build \
    && cp staticwebapp.config.json out/

# Craft serves precompressed frontend assets when they are present. Generate
# matching gzip and Brotli files so the base image cannot serve stale copies.
RUN apt-get update \
    && apt-get install -y --no-install-recommends brotli gzip \
    && find out -type f ! -name '*.br' ! -name '*.gz' -exec gzip -9 -k -f '{}' \; \
    && find out -type f ! -name '*.br' ! -name '*.gz' -exec brotli -q 11 -k -f '{}' \; \
    && rm -rf /var/lib/apt/lists/*

# CIPP NG 10.9.1 (linux/amd64). Update this digest together with the frontend
# version when merging a new upstream CIPP release.
FROM ghcr.io/cyberdrain/cipp@sha256:4f0fd82867237d57ae4a5569d0b1c70def056d05644f9e0935721a73435bf1ff

COPY --from=frontend-build --chown=1654:1654 /src/out/ /app/Frontend/
